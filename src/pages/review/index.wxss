.check-title { color:var(--yy-v3-review); font-size:27rpx; font-weight:600; }.check-copy,.standard-point { width:100%; margin-top:12rpx; color:var(--yy-v3-text-secondary); font-size:24rpx; line-height:1.7; text-align:left; }.due-sub { margin-top:14rpx; color:var(--yy-v3-text-muted); font-size:21rpx; }.follow-up { margin-top:16rpx; padding:16rpx; border-left:3rpx solid var(--yy-v3-review); color:var(--yy-v3-text-secondary); background:var(--yy-v3-review-ambient); font-size:23rpx; line-height:1.6; }.follow-up text,.citation-line,.follow-up-result text { color:var(--yy-v3-text-muted); font-size:20rpx; }.follow-up-action { display:flex; min-height:var(--yy-v3-touch,88rpx); align-items:center; justify-content:center; margin:14rpx 0; border:1rpx solid var(--yy-v3-line-strong); border-radius:var(--yy-v3-radius-control,24rpx); color:var(--yy-v3-review); background:transparent; font-size:22rpx; }.follow-up-result { width:100%; margin-top:16rpx; padding-top:14rpx; border-top:1rpx solid var(--yy-v3-line); text-align:left; }.follow-up-result view { margin-top:7rpx; color:var(--yy-v3-text-secondary); font-size:22rpx; }.citation-line { width:100%; margin-top:18rpx; text-align:left; }
