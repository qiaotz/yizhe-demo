.history-toggle-icon { justify-self:end; color:var(--yy-v3-preview); font-size:30rpx; font-weight:400; line-height:40rpx; text-align:right; }

/* V3.1 PREVIEW SAMPLE — START
 * CSS-only trial. Keeps the current WXML/JS/data contracts untouched.
 * Signature: a restrained clinical learning-path rail from subject to knowledge card.
 */
page { --yy-v3-tab-height:256rpx; }

.prototype-card {
  margin-top:20rpx;
  padding:28rpx;
  border-color:var(--yy-v3-line);
  border-radius:var(--yy-v3-radius-card);
  background:var(--yy-v3-surface);
}

.resume-card {
  overflow:hidden;
  padding:30rpx 30rpx 28rpx;
  border-color:var(--yy-v3-preview-border);
  background:linear-gradient(180deg,var(--yy-v3-preview-soft),var(--yy-v3-surface) 72%);
  box-shadow:0 18rpx 52rpx rgba(0,0,0,.2);
}

.resume-card ~ .resume-card {
  border-color:var(--yy-v3-line);
  background:var(--yy-v3-surface);
  box-shadow:none;
}

.resume-card ~ .resume-card .eyebrow { color:var(--yy-v3-text-muted); }
.resume-card .eyebrow { font-size:23rpx; line-height:32rpx; letter-spacing:.08em; }
.resume-card .card-title { margin-top:14rpx; font-size:32rpx; line-height:44rpx; }
.resume-card .card-sub { margin-top:10rpx; color:var(--yy-v3-text-secondary); font-size:27rpx; line-height:42rpx; }
.resume-card yy-button { margin-top:26rpx; }
.resume-card .text-action { margin-top:4rpx; border-top:1rpx solid var(--yy-v3-line); }

.catalog-card {
  padding:24rpx 20rpx 18rpx;
  border-color:var(--yy-v3-line-strong);
  background:var(--yy-v3-surface-muted);
}

.card-heading {
  min-height:64rpx;
  padding:0 4rpx 12rpx;
  border-bottom:1rpx solid var(--yy-v3-line);
}

.card-heading-title { font-size:32rpx; line-height:44rpx; letter-spacing:.01em; }
.chip.focus { min-height:40rpx; padding:2rpx 14rpx; border-color:var(--yy-v3-preview-border); background:var(--yy-v3-preview-soft); }
.catalog-disclosure { margin-top:0; padding-right:4rpx; padding-left:4rpx; }
.tree { margin-top:14rpx; }

.subject-node {
  overflow:hidden;
  margin-bottom:0;
  border:1rpx solid var(--yy-v3-line-strong);
  border-radius:22rpx;
  background:var(--yy-v3-surface);
}

.subject-head {
  min-height:92rpx;
  padding:18rpx 20rpx;
  border:0;
  border-radius:0;
  background:linear-gradient(180deg,rgba(255,255,255,.025),rgba(255,255,255,0)),var(--yy-v3-surface-raised);
  box-shadow:inset 0 -1rpx 0 var(--yy-v3-line);
}

.subject-head .tree-title {
  font-size:28rpx;
  line-height:40rpx;
  font-weight:600;
  letter-spacing:.01em;
}

.subject-head > .chip {
  min-width:76rpx;
  min-height:36rpx;
  justify-content:center;
  padding:0 12rpx;
  border-color:var(--yy-v3-line-strong);
  color:var(--yy-v3-text-secondary);
  background:var(--yy-v3-surface);
  font-size:20rpx;
  line-height:28rpx;
  font-weight:500;
}

.subject-node + .subject-node { margin-top:12rpx; }

.subject-body {
  margin-left:0;
  padding:12rpx;
  border-left:0;
  background:var(--yy-v3-surface-muted);
}

.chapter-node {
  margin-bottom:10rpx;
  border-color:var(--yy-v3-line);
  border-radius:22rpx;
  background:var(--yy-v3-surface);
}

.chapter-node.current {
  border-color:var(--yy-v3-preview-strong);
  background:linear-gradient(100deg,var(--yy-v3-preview-soft),var(--yy-v3-surface) 44%);
}

.tree-head image,.lesson-head image {
  width:28rpx;
  height:28rpx;
  opacity:.72;
  transition:transform var(--yy-v3-duration-fast) var(--yy-v3-ease-out),opacity var(--yy-v3-duration-fast) var(--yy-v3-ease-out);
}

.tree-node.open > .tree-head > image,.lesson-node.open > .lesson-head > image { opacity:1; }
.chapter-head {
  display:grid;
  grid-template-columns:28rpx minmax(0,1fr) auto;
  align-items:start;
  gap:12rpx;
  padding:18rpx 16rpx;
}

.chapter-head > image { margin-top:6rpx; }
.chapter-copy { padding-right:2rpx; }
.chapter-name {
  color:var(--yy-v3-text);
  font-size:28rpx;
  line-height:40rpx;
  font-weight:600;
  word-break:break-word;
}

.chapter-meta {
  margin-top:4rpx;
  color:var(--yy-v3-text-muted);
  font-size:21rpx;
  line-height:30rpx;
  font-weight:400;
}

.chapter-head > .chip {
  min-width:84rpx;
  min-height:36rpx;
  margin-top:2rpx;
  padding:0 8rpx;
  border-color:transparent;
  background:transparent;
  color:var(--yy-v3-text-muted);
  font-size:20rpx;
  line-height:28rpx;
  font-weight:500;
}

.chapter-node.current .chapter-head > .chip {
  border-color:var(--yy-v3-preview-border);
  background:var(--yy-v3-preview-soft);
  color:var(--yy-v3-preview);
}

.chapter-body { padding:0 8rpx 10rpx; }
.lesson-node { margin-top:8rpx; border:0; border-radius:0; background:transparent; }
.lesson-node + .lesson-node { border-top:1rpx solid var(--yy-v3-line); }
.lesson-head {
  display:grid;
  grid-template-columns:28rpx minmax(0,1fr) auto;
  align-items:start;
  gap:12rpx;
  padding:15rpx 14rpx;
}

.lesson-head > image { margin-top:5rpx; }
.lesson-head > text {
  color:var(--yy-v3-text);
  font-size:27rpx;
  line-height:40rpx;
  font-weight:500;
  word-break:break-word;
}

.lesson-head > .chip {
  min-height:32rpx;
  margin-top:3rpx;
  padding:0;
  border-color:transparent;
  background:transparent;
  color:var(--yy-v3-text-muted);
  font-size:20rpx;
  line-height:28rpx;
  font-weight:400;
  text-align:right;
}

.lesson-node.open > .lesson-head {
  border-bottom:1rpx solid var(--yy-v3-preview-soft);
  background:var(--yy-v3-preview-ambient);
}

.lesson-node.open > .lesson-head > text { font-weight:600; }
.lesson-node.open > .lesson-head > .chip { color:var(--yy-v3-text-secondary); font-weight:500; }

.knowledge-list {
  margin:0 8rpx 12rpx 12rpx;
  padding:4rpx 0 4rpx 26rpx;
  border-left:2rpx solid var(--yy-v3-preview-border);
  border-radius:0;
  background:rgba(10,15,22,.22);
}

.knowledge-row {
  display:block;
  width:100%;
  min-width:0;
  padding:14rpx 0;
  text-align:left;
  font-size:26rpx;
  line-height:38rpx;
}

.knowledge-row + .knowledge-row { border-top-color:rgba(170,182,197,.08); }

.knowledge-row-layout {
  display:flex;
  width:100%;
  min-width:0;
  align-items:flex-start;
  justify-content:flex-start;
  gap:10rpx;
  text-align:left;
}

.knowledge-row-layout > .status-dot {
  width:10rpx;
  height:10rpx;
  flex:0 0 10rpx;
  margin-top:13rpx;
}

.knowledge-row-layout > text {
  flex:1 1 0;
  min-width:0;
  color:var(--yy-v3-text-secondary);
  font-size:24rpx;
  font-weight:500;
  line-height:36rpx;
  text-align:left;
  word-break:break-word;
}

.knowledge-row-layout > .chip.status {
  flex:0 0 auto;
  min-height:32rpx;
  margin:4rpx 0 0;
  padding:0;
  border-color:transparent;
  background:transparent;
  color:var(--yy-v3-text-muted);
  font-size:21rpx;
  line-height:30rpx;
  font-weight:400;
  text-align:right;
  white-space:nowrap;
}

.knowledge-row-layout > .chip.status.ok,
.knowledge-row-layout > .chip.status.mid,
.knowledge-row-layout > .chip.status.bad {
  border-color:transparent;
  background:transparent;
  color:var(--yy-v3-text-muted);
}

.history-card {
  margin-top:24rpx;
  padding:0;
  border:0;
  border-radius:0;
  background:transparent;
}

.history-heading { padding:0 4rpx 4rpx; }
.history-title { font-size:28rpx; }
.history-list { overflow:visible; border-top:0; }
.history-row {
  min-height:116rpx;
  margin-top:12rpx;
  border:1rpx solid var(--yy-v3-line);
  border-radius:var(--yy-v3-radius-control);
  background:var(--yy-v3-surface);
