.follow-up-action[disabled]:not([disabled="false"]),.card-actions button[disabled]:not([disabled="false"]),.rating-actions button[disabled]:not([disabled="false"]) { color:var(--yy-v3-text-muted); border-color:var(--yy-v3-line); background:var(--yy-v3-surface-muted); opacity:1; }
.result-kicker { margin-top:32rpx; color:var(--yy-v3-review); font-size:24rpx; font-weight:600; }.result-title { margin-top:10rpx; color:var(--yy-v3-text); font-size:34rpx; font-weight:600; }.result-stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16rpx; margin:30rpx 0 22rpx; }.result-stats view { display:flex; min-height:138rpx; flex-direction:column; align-items:center; justify-content:center; border:1rpx solid var(--yy-v3-line); border-radius:var(--yy-v3-radius-control,24rpx); background:var(--yy-v3-surface); }.result-stats view text:first-child { font-size:38rpx; font-weight:600; }.result-stats view text:last-child { margin-top:5rpx; color:var(--yy-v3-text-muted); font-size:22rpx; }.remembered { color:var(--yy-v3-review); }.vague { color:var(--yy-v3-class); }.forgot { color:var(--yy-v3-correction); }.weak-card { margin-bottom:22rpx; padding:26rpx; border:1rpx solid var(--yy-v3-line); border-radius:var(--yy-v3-radius-card,32rpx); background:var(--yy-v3-surface); }.weak-title { margin-bottom:10rpx; color:var(--yy-v3-text); font-size:27rpx; font-weight:600; }.weak-row { display:flex; min-height:var(--yy-v3-touch,88rpx); align-items:center; justify-content:space-between; border-top:1rpx solid var(--yy-v3-line); color:var(--yy-v3-text-secondary); font-size:24rpx; }.weak-row text:last-child { color:var(--yy-v3-text-muted); font-size:21rpx; }.result-note { margin:20rpx 0; padding:20rpx; border-left:4rpx solid var(--yy-v3-review); color:var(--yy-v3-text-secondary); background:var(--yy-v3-review-soft); font-size:23rpx; line-height:1.6; }.result-secondary { width:100%; min-height:var(--yy-v3-touch,88rpx); margin-top:8rpx; color:var(--yy-v3-text-secondary); background:transparent; font-size:24rpx; }
