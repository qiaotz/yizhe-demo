.showcase{padding:38rpx 40rpx 50rpx;color:#f2f5f8;background:#0a0f16;min-height:100vh;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
.showcase-masthead{display:flex;align-items:center;gap:16rpx;padding-top:env(safe-area-inset-top);margin-bottom:76rpx}
.brand-mark{width:62rpx;height:62rpx;border:1rpx solid #457085;border-radius:18rpx;display:flex;align-items:center;justify-content:center;font-family:"Songti SC","STSong","SimSun",serif;font-size:40rpx;background:#132331;color:#bae4eb}
.brand-name{font-size:31rpx;letter-spacing:5rpx;font-weight:600}.demo-pill{margin-left:auto;border:1rpx solid #30414e;color:#a6bac8;border-radius:999rpx;padding:8rpx 17rpx;font-size:20rpx;letter-spacing:2rpx}
.eyebrow{font-size:22rpx;line-height:1.6;color:#71c9d6;letter-spacing:2rpx}.showcase-title{margin-top:24rpx;font-family:"Songti SC","STSong","SimSun",serif;font-size:88rpx;line-height:1.19;letter-spacing:-2rpx;font-weight:500}.showcase-description{margin-top:30rpx;font-size:28rpx;line-height:1.8;color:#aebfcd;max-width:600rpx}.access-note{margin:30rpx 0 26rpx;display:flex;align-items:center;gap:12rpx;color:#91a5b4;font-size:22rpx}.access-dot{width:10rpx;height:10rpx;border-radius:50%;background:#6ac8ba}
.primary-action{display:flex;justify-content:space-between;align-items:center;width:100%;padding:0 30rpx;height:102rpx;border:1rpx solid #81cdd6;border-radius:20rpx;background:#8dd3db;color:#09232b;font-size:29rpx;font-weight:600;line-height:1}.primary-action text{font-size:38rpx}.primary-action::after,.resume-action::after,.feature-entry::after,.details-toggle::after,.showcase-footer button::after{display:none}.action-pressed{opacity:.87}.resume-action{background:transparent;color:#abdbe1;font-size:25rpx;height:78rpx;line-height:78rpx;margin-top:8rpx}.journey-panel{margin-top:42rpx;padding:30rpx 24rpx 24rpx;background:#111c28;border:1rpx solid #263542;border-radius:24rpx}.panel-label{font-size:22rpx;color:#a0b4c4}.journey-steps{display:flex;justify-content:space-between;margin:28rpx 0 30rpx;gap:8rpx}.journey-step{flex:1;display:flex;flex-direction:column;gap:15rpx}.journey-step text:first-child{font-size:26rpx;color:#d8e4ee}.journey-step text:last-child{font-size:19rpx;color:#94a8b8;white-space:nowrap}.journey-step view{height:6rpx;border-radius:4rpx;background:#4cbfd3}.classroom view{background:#d6a84b}.practice view{background:#5b7fff}.correction view{background:#e96b50}.review view{background:#3fb982}.sample-topic{border-top:1rpx solid #293744;padding-top:22rpx;display:flex;gap:16rpx;font-size:22rpx;color:#c3d1dc}.sample-topic text:first-child{color:#7f96a7;white-space:nowrap}.highlights{margin-top:56rpx}.section-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx;font-size:27rpx}.section-heading text:last-child{font-size:20rpx;color:#708b9e}.feature-entry{width:100%;display:flex;align-items:center;gap:20rpx;background:transparent;border:0;border-bottom:1rpx solid #213140;padding:25rpx 0;text-align:left;border-radius:0;color:#e5edf4;line-height:1.5}.entry-symbol{font-size:46rpx;width:48rpx;color:#e99b86}.entry-copy{display:flex;flex:1;flex-direction:column;gap:5rpx}.entry-copy text:first-child{font-size:27rpx;font-weight:500}.entry-copy text:last-child{font-size:21rpx;color:#93a9ba}.entry-arrow{font-size:28rpx;color:#89a4b6}.classroom-entry .entry-symbol{color:#d6b871}.review-entry .entry-symbol{color:#66c9a0}.entry-pressed{background:#13212d}.demo-explanation{margin-top:42rpx;padding:24rpx;background:#0e1923;border-left:3rpx solid #426678;border-radius:0 16rpx 16rpx 0;color:#8fa6b8;font-size:23rpx;line-height:1.75}.note-title{color:#bfd0dd;margin-bottom:8rpx;font-size:23rpx}.details-toggle{display:flex;align-items:center;justify-content:space-between;border:0;border-bottom:1rpx solid #233543;color:#b3c6d5;background:transparent;border-radius:0;padding:27rpx 0;text-align:left;font-size:25rpx}.project-details{padding:5rpx 0 16rpx}.project-details>view{display:flex;flex-direction:column;gap:10rpx;margin-top:24rpx;font-size:23rpx;line-height:1.7;color:#91a8ba}.project-details>view>text:first-child{color:#cee0ed;font-weight:500}.showcase-footer{display:flex;justify-content:space-between;align-items:center;margin-top:40rpx;font-size:20rpx;color:#70899e}.showcase-footer button{margin:0;padding:12rpx 0 12rpx 14rpx;background:transparent;border:0;color:#94b4c9;font-size:21rpx;line-height:1.5}.showcase button:focus-visible{outline:3rpx solid #b9ecf2;outline-offset:6rpx}@media(prefers-reduced-motion:reduce){.showcase *{transition:none!important}}

.entry-layout{display:flex;align-items:center;gap:20rpx;width:100%;text-align:left}.primary-layout{display:flex;align-items:center;justify-content:space-between;width:100%}.primary-layout>text:first-child{font-size:29rpx}
