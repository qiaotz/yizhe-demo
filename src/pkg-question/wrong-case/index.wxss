page { background:#0A0F16; }
button,textarea { font-family:var(--yy-v3-font); }
.ai-summary-button,.reason-pills button { position:relative; overflow:hidden; }
.secondary-action,.review-link { position:relative; }
.ai-summary-button > .weapp-btn,
.reason-pills button > .weapp-btn,
.secondary-action > .weapp-btn,
.review-link > .weapp-btn { position:relative; inset:auto; display:flex; width:100%; height:auto; min-height:0; box-sizing:border-box; flex-direction:inherit; align-items:inherit; justify-content:inherit; gap:inherit; padding:0; border:0; border-radius:inherit; color:inherit; background:transparent; font:inherit; line-height:inherit; text-align:inherit; }
.ai-summary-button > .weapp-btn,
.reason-pills button > .weapp-btn { width:auto; min-width:0; flex:1 1 auto; }
.ai-summary-button > .weapp-btn > .weapp-btn__content,
.reason-pills button > .weapp-btn > .weapp-btn__content,
.secondary-action > .weapp-btn > .weapp-btn__content,
.review-link > .weapp-btn > .weapp-btn__content { display:flex; width:100%; height:auto; min-width:0; min-height:0; flex-direction:inherit; align-items:inherit; justify-content:inherit; gap:inherit; }
.ai-summary-button > .weapp-btn > .weapp-btn__content,
.reason-pills button > .weapp-btn > .weapp-btn__content { width:auto; }
.ai-summary-button > .weapp-btn > .weapp-btn__content > .weapp-btn__text,
.reason-pills button > .weapp-btn > .weapp-btn__content > .weapp-btn__text,
.secondary-action > .weapp-btn > .weapp-btn__content > .weapp-btn__text,
.review-link > .weapp-btn > .weapp-btn__content > .weapp-btn__text { display:contents; }
.case-meta { display:flex; min-height:54rpx; align-items:center; justify-content:space-between; gap:16rpx; color:var(--yy-v3-text-muted); font-size:23rpx; }
.attempt-chip { flex:none; padding:6rpx 16rpx; border:1rpx solid var(--yy-v3-correction-strong); border-radius:999rpx; color:var(--yy-v3-correction); background:var(--yy-v3-correction-soft); }
.evidence-card { margin-top:18rpx; padding:26rpx; border:1rpx solid var(--yy-v3-line); border-radius:30rpx; background:var(--yy-v3-surface); }
.case-stem { color:var(--yy-v3-text); font-size:29rpx; line-height:1.65; font-weight:600; }
.answer-option { display:flex; min-height:86rpx; box-sizing:border-box; align-items:center; gap:18rpx; margin-top:16rpx; padding:16rpx 18rpx; border:1rpx solid var(--yy-v3-line); border-radius:24rpx; color:var(--yy-v3-text-secondary); background:var(--yy-v3-surface-raised); }
.answer-option.correct { border-color:var(--yy-v3-review); background:var(--yy-v3-review-soft); }.answer-option.wrong { border-color:var(--yy-v3-correction); background:var(--yy-v3-correction-soft); }
.option-key { display:flex; width:42rpx; height:42rpx; flex:none; align-items:center; justify-content:center; border:1rpx solid var(--yy-v3-line-strong); border-radius:12rpx; font-size:22rpx; font-weight:600; }
.correct .option-key { color:var(--yy-v3-review); border-color:var(--yy-v3-review); }.wrong .option-key { color:var(--yy-v3-correction); border-color:var(--yy-v3-correction); }
.option-copy { min-width:0; flex:1; font-size:26rpx; line-height:1.55; }.option-state { flex:none; color:var(--yy-v3-text-muted); font-size:20rpx; }
.correct .option-state { color:var(--yy-v3-review); }.wrong .option-state { color:var(--yy-v3-correction); }
.answer-summary { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:18rpx; }.answer-summary text { padding:6rpx 15rpx; border-radius:999rpx; font-size:21rpx; }.wrong-answer { color:var(--yy-v3-correction); background:var(--yy-v3-correction-soft); }.correct-answer { color:var(--yy-v3-review); background:var(--yy-v3-review-soft); }
.explanation-block { margin-top:20rpx; padding:20rpx; border:1rpx solid var(--yy-v3-line); border-radius:20rpx; background:var(--yy-v3-surface-muted); }.explanation-title { color:var(--yy-v3-text); font-size:25rpx; font-weight:600; }.explanation-copy { margin-top:8rpx; color:var(--yy-v3-text-secondary); font-size:25rpx; line-height:1.7; white-space:pre-wrap; }
.case-history { margin-top:16rpx; color:var(--yy-v3-text-muted); font-size:21rpx; line-height:1.5; }
.flow-track { display:flex; align-items:flex-start; justify-content:space-between; margin:26rpx 4rpx; }.flow-node { position:relative; display:flex; width:20%; flex-direction:column; align-items:center; color:var(--yy-v3-text-muted); font-size:20rpx; }.flow-dot { z-index:1; display:flex; width:34rpx; height:34rpx; flex:0 0 34rpx; align-items:center; justify-content:center; border:2rpx solid var(--yy-v3-line-strong); border-radius:50%; background:var(--yy-v3-surface-muted); }.flow-node > text { margin-top:8rpx; }.flow-line { position:absolute; top:17rpx; left:60%; width:80%; height:2rpx; background:var(--yy-v3-line-strong); }.flow-node.done,.flow-node.current { color:var(--yy-v3-correction); }.flow-node.done .flow-dot { color:var(--yy-v3-accent-ink); border-color:var(--yy-v3-correction); background:var(--yy-v3-correction); }.flow-node.current .flow-dot { border-color:var(--yy-v3-correction); box-shadow:0 0 0 6rpx var(--yy-v3-correction-soft); }
.flow-node.flow-node-three { width:33.333%; }
.reason-section,.waiting-card { padding:26rpx; border:1rpx solid var(--yy-v3-line); border-radius:30rpx; background:var(--yy-v3-surface); }.section-title,.waiting-title { color:var(--yy-v3-text); font-size:30rpx; font-weight:600; }
.reason-heading { display:flex; min-width:0; align-items:center; justify-content:space-between; gap:16rpx; }.reason-heading .section-title { min-width:0; flex:1; }.ai-summary-button { display:flex; width:auto; min-width:190rpx; min-height:64rpx; box-sizing:border-box; flex:none; align-items:center; justify-content:center; margin:0; padding:8rpx 18rpx; border:1rpx solid var(--yy-v3-correction); border-radius:999rpx; color:var(--yy-v3-correction); background:var(--yy-v3-correction-soft); font-size:21rpx; line-height:1.2; }.ai-summary-button.loading { opacity:.75; }.ai-summary-button.success { background:var(--yy-v3-correction-soft); }.reason-section.needs-reason { border-color:var(--yy-v3-correction); box-shadow:0 0 0 4rpx var(--yy-v3-correction-soft); }.ai-summary-message { margin-top:14rpx; color:var(--yy-v3-text-muted); font-size:21rpx; line-height:1.5; }.ai-summary-message.success { color:var(--yy-v3-correction); }.ai-summary-message.error { color:var(--yy-v3-text-secondary); }
.ai-demo-note { display:flex; width:100%; box-sizing:border-box; align-items:flex-start; gap:12rpx; margin-top:16rpx; padding:14rpx 16rpx; border:1rpx solid var(--yy-v3-line); border-radius:var(--yy-v3-radius-compact,16rpx); color:var(--yy-v3-text-muted); background:var(--yy-v3-surface-muted); font-size:21rpx; line-height:1.5; }.ai-demo-note text:first-child { flex:none; color:var(--yy-v3-correction); font-weight:600; }.ai-demo-note text:last-child { min-width:0; flex:1; }
.reason-pills { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:20rpx; }.reason-pills button { display:flex; width:auto; min-height:var(--yy-v3-touch,88rpx); box-sizing:border-box; align-items:center; justify-content:center; gap:8rpx; margin:0; padding:8rpx 20rpx; border:1rpx solid var(--yy-v3-line-strong); border-radius:var(--yy-v3-radius-pill,999rpx); color:var(--yy-v3-text-secondary); background:transparent; font-size:22rpx; line-height:1.2; text-align:center; }.reason-pills button.active { color:var(--yy-v3-correction); border-color:var(--yy-v3-correction); background:var(--yy-v3-correction-soft); }.reason-label { min-width:0; }.guide-option-hint { flex:none; padding:5rpx 9rpx; border:1rpx solid var(--yy-v3-correction); border-radius:var(--yy-v3-radius-pill,999rpx); color:var(--yy-v3-correction); background:var(--yy-v3-surface-raised); font-size:18rpx; font-weight:600; line-height:1; white-space:nowrap; }
.record-panel { margin-top:24rpx; padding-top:4rpx; border-top:1rpx solid var(--yy-v3-line); }.field-label { margin:22rpx 0 10rpx; color:var(--yy-v3-text-secondary); font-size:24rpx; font-weight:500; }.field-label text { color:var(--yy-v3-correction); }.record-input { width:100%; min-height:132rpx; box-sizing:border-box; padding:20rpx; border:1rpx solid var(--yy-v3-line); border-radius:20rpx; color:var(--yy-v3-text); background:var(--yy-v3-surface-raised); font-size:25rpx; line-height:1.65; }
.waiting-card { display:flex; min-height:430rpx; box-sizing:border-box; flex-direction:column; align-items:center; justify-content:center; text-align:center; }.clock-ring,.count-ring { display:flex; width:84rpx; height:84rpx; align-items:center; justify-content:center; margin-bottom:22rpx; border:2rpx solid var(--yy-v3-correction); border-radius:50%; color:var(--yy-v3-correction); background:var(--yy-v3-correction-soft); font-size:25rpx; font-weight:600; }.clock-ring.ready { border-color:var(--yy-v3-review); background:var(--yy-v3-review-soft); }.clock-ring image { width:48rpx; height:48rpx; }.waiting-copy { max-width:560rpx; margin-top:12rpx; color:var(--yy-v3-text-secondary); font-size:24rpx; line-height:1.7; }
.waiting-screen { min-height:720rpx; margin-top:24rpx; padding:46rpx 26rpx; justify-content:flex-start; }
.flow-mini { display:flex; width:100%; justify-content:space-between; margin-top:24rpx; padding-top:18rpx; border-top:1rpx solid var(--yy-v3-line); color:var(--yy-v3-text-muted); font-size:20rpx; }.flow-mini .done { color:var(--yy-v3-correction); }.flow-mini .current { color:var(--yy-v3-text); font-weight:600; }
.due-panel { display:flex; width:100%; box-sizing:border-box; align-items:center; justify-content:space-between; gap:18rpx; margin-top:22rpx; padding:18rpx 20rpx; border:1rpx solid var(--yy-v3-line); border-radius:18rpx; background:var(--yy-v3-surface-raised); text-align:left; }.due-panel view text { display:block; color:var(--yy-v3-text-secondary); font-size:22rpx; }.due-panel view text:last-child { margin-top:3rpx; color:var(--yy-v3-text-muted); font-size:20rpx; }.countdown { flex:none; color:var(--yy-v3-correction); font-size:23rpx; font-weight:600; }
.secondary-action,.review-link { display:flex; width:100%; min-height:var(--yy-v3-touch,88rpx); box-sizing:border-box; align-items:center; justify-content:center; margin-top:16rpx; padding:14rpx 18rpx; border:1rpx solid var(--yy-v3-line-strong); border-radius:var(--yy-v3-radius-control,24rpx); color:var(--yy-v3-text-secondary); background:transparent; font-size:23rpx; line-height:1.4; text-align:center; }.review-link { border:0; color:var(--yy-v3-review); font-size:22rpx; }
.secondary-action.note-secondary { color:var(--yy-v3-correction); border-color:var(--yy-v3-correction-border); background:var(--yy-v3-correction-soft); }
.unavailable-note { margin-top:20rpx; padding:16rpx; border-left:3rpx solid var(--yy-v3-line-strong); color:var(--yy-v3-text-muted); background:var(--yy-v3-surface-muted); font-size:21rpx; line-height:1.6; }
.case-note-entry { display:grid; min-height:108rpx; box-sizing:border-box; grid-template-columns:42rpx minmax(0,1fr) auto; align-items:center; gap:16rpx; margin-top:18rpx; padding:20rpx 22rpx; border:1rpx solid var(--yy-v3-line); border-radius:20rpx; background:var(--yy-v3-surface); }
.case-note-entry image { width:34rpx; height:34rpx; }
.case-note-entry > view { min-width:0; }
.case-note-title { color:var(--yy-v3-text); font-size:25rpx; font-weight:600; line-height:36rpx; }
.case-note-entry view text { display:block; margin-top:3rpx; color:var(--yy-v3-text-muted); font-size:21rpx; line-height:31rpx; }
.case-note-action { color:var(--yy-v3-practice); font-size:22rpx; font-weight:500; }
.secondary-action { display:flex; box-sizing:border-box; align-items:center; justify-content:center; line-height:1.4; text-align:center; white-space:normal; word-break:break-word; }
@media (max-width:374px) { .reason-section { padding:22rpx; }.reason-heading { gap:10rpx; }.reason-heading .section-title { font-size:28rpx; }.ai-summary-button { min-width:176rpx; padding:8rpx 14rpx; font-size:20rpx; } }
