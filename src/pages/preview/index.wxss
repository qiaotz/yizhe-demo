.history-mastery { flex:none; min-width:70rpx; box-sizing:border-box; margin-top:1rpx; padding:5rpx 15rpx; border:1rpx solid currentColor; border-radius:999rpx; font-size:21rpx; font-weight:500; line-height:30rpx; text-align:center; }
.history-mastery.mid { color:var(--yy-v3-class); background:var(--yy-v3-class-soft); }
