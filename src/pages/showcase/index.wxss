.welcome-page{min-height:100vh;box-sizing:border-box;background:#0a1016;color:#ecf0f5;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
.welcome-content{padding:20rpx 30rpx 24rpx}.welcome-brand{display:flex;align-items:center;gap:14rpx;font-size:24rpx;font-weight:600}.welcome-dots{display:flex;gap:5rpx}.welcome-dots>view{width:10rpx;height:10rpx;border-radius:50%;background:#2bc7db;box-shadow:0 0 12rpx #2bc7db55}.welcome-dots>view:nth-child(2){background:#d8b454}.welcome-dots>view:nth-child(3){background:#8071ff}.welcome-dots>view:nth-child(4){background:#ed6777}.welcome-dots>view:nth-child(5){background:#43d3a4}
.welcome-title{font-size:42rpx;font-weight:650;line-height:1.45;margin-top:20rpx;letter-spacing:0}.welcome-subtitle{color:#a6aeb7;line-height:1.75;font-size:24rpx;margin-top:14rpx}.welcome-video-label{display:flex;justify-content:space-between;margin:28rpx 0 14rpx;font-size:25rpx;font-weight:600}.welcome-video-label>text:last-child{font-size:22rpx;color:#86939f;font-weight:400}
.welcome-video-cover{position:relative;display:block;padding:0;width:100%;height:388rpx;box-sizing:border-box;border:1rpx solid #394450;border-radius:24rpx;overflow:hidden;background:#071323;line-height:1}.welcome-video-cover::after,.welcome-start::after,.welcome-skip::after,.welcome-resume::after{display:none}.welcome-cover-image{display:block;width:100%;height:100%}.welcome-play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);color:#f0f5fb;font-size:70rpx;text-shadow:0 3rpx 24rpx #001322}.welcome-duration{position:absolute;bottom:20rpx;right:24rpx;color:#f5f7ff;font-size:26rpx;background:#071323aa;padding:6rpx 12rpx;border-radius:8rpx}.welcome-video{display:block;width:100%;height:388rpx;border-radius:24rpx;overflow:hidden;background:#000}.welcome-video-note{color:#94a0ac;font-size:22rpx;line-height:1.5;margin-top:14rpx}.welcome-version{color:#768794;font-size:19rpx;line-height:1.6;margin-top:5rpx}
.welcome-journey{background:linear-gradient(125deg,#172a32,#16202c 70%);border:1rpx solid #34434e;border-radius:26rpx;padding:26rpx 24rpx;margin-top:28rpx}.welcome-journey-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12rpx}.welcome-journey-title{font-size:27rpx;font-weight:600;margin-bottom:8rpx}.welcome-journey-head text{color:#9dacb6;font-size:22rpx}.welcome-badge{white-space:nowrap;border:1rpx solid #34444f;border-radius:30rpx;padding:8rpx 12rpx}.welcome-steps{display:flex;gap:7rpx;margin:25rpx 0 20rpx}.welcome-steps>view{flex:1;min-width:0;color:#26cbe1;font-size:23rpx;font-weight:600}.welcome-steps>view>view{height:6rpx;margin-bottom:12rpx;border-radius:5rpx;background:currentColor;box-shadow:0 0 12rpx currentColor}.welcome-steps>.step-class{color:#ddb75b}.welcome-steps>.step-practice{color:#8576ff}.welcome-steps>.step-correction{color:#f16f83}.welcome-steps>.step-review{color:#3fd3a3}.welcome-journey-copy{border-top:1rpx solid #31404a;padding-top:18rpx;color:#a8b5c0;font-size:22rpx;line-height:1.8}.welcome-safe{font-size:21rpx;color:#9caeba;text-align:center;line-height:1.7;margin-top:28rpx}.welcome-example{text-align:center;color:#718693;font-size:19rpx;margin-top:8rpx;line-height:1.6}
.welcome-actions{position:sticky;bottom:0;padding:16rpx 30rpx calc(12rpx + env(safe-area-inset-bottom));background:#0a1016f5;border-top:1rpx solid #26313a;z-index:70}.welcome-start{display:block;width:100%;height:86rpx;padding:0;border:0;border-radius:20rpx;background:#5fc9f2;color:#081c26;font-size:28rpx;font-weight:600;line-height:86rpx}.welcome-skip,.welcome-resume{background:transparent;color:#a4b2bd;border:0;font-size:24rpx;line-height:1.5;padding:18rpx 0 6rpx}.welcome-resume{color:#6bcde6}.welcome-page button:focus-visible{outline:3rpx solid #77d7f3;outline-offset:3rpx}
.welcome-more{background:transparent;color:#92a5b0;font-size:22rpx;border:0;margin-top:12rpx}.welcome-more::after,.welcome-explore button::after{display:none}.welcome-explore{display:grid;grid-template-columns:1fr 1fr;gap:10rpx;padding-top:12rpx}.welcome-explore button{background:#15212c;color:#bccbd4;font-size:22rpx;border:1rpx solid #2b3e4b;border-radius:12rpx;line-height:1.5;padding:18rpx 10rpx;margin:0}
