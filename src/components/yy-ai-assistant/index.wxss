  color: #DCE5EE;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0;
  white-space: normal;
  word-break: break-word;
}

.target-button::after {
  border: 0;
}

.target-heading text {
  color: #E7EDF4;
  font-size: 24rpx;
  font-weight: 600;
}

.target-button.active {
  border-color: #E4AD4F;
  background: rgba(199, 148, 60, .16);
  color: #F4C56A;
  font-weight: 700;
}

.icon-close {
  width: var(--yy-v3-touch, 88rpx);
  min-width: var(--yy-v3-touch, 88rpx);
  max-width: var(--yy-v3-touch, 88rpx);
  height: var(--yy-v3-touch, 88rpx);
  max-height: var(--yy-v3-touch, 88rpx);
  flex-basis: var(--yy-v3-touch, 88rpx);
}

.primary-cta,
.quick-list button,
.reason-list button,
.retry-row button,
.availability-actions button,
.segmented button,
.feedback-submit {
  height: auto;
  max-height: none;
  padding-top: 12rpx;
  padding-bottom: 12rpx;
  line-height: 1.25;
  white-space: normal;
}

button.send-button {
  width: var(--yy-v3-touch, 88rpx);
  min-width: var(--yy-v3-touch, 88rpx);
  max-width: var(--yy-v3-touch, 88rpx);
  height: var(--yy-v3-touch, 88rpx);
  max-height: var(--yy-v3-touch, 88rpx);
  flex-basis: var(--yy-v3-touch, 88rpx);
}

.input-shell {
  height: 196rpx;
  min-height: 196rpx;
  max-height: none;
}

.ai-input {
  height: 196rpx;
  min-height: 196rpx;
  max-height: none;
  padding-bottom: 108rpx;
}

/* Formal and local-demo modes render this same production CTA. Keep its box
 * independent from label length so demo copy cannot make the control taller. */
.primary-cta {
  width: 100% !important;
  min-width: 100% !important;
  max-width: 100% !important;
  height: var(--yy-v3-touch, 88rpx);
  min-height: var(--yy-v3-touch, 88rpx);
  max-height: var(--yy-v3-touch, 88rpx);
  padding: 0 20rpx;
  font-size: 25rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.primary-cta text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* H5 Web Runtime parity: retain the real button for focus/click semantics,
 * but prevent its built-in 44px box from inflating the authored control. */
.weapp-btn--default > .weapp-btn { position:absolute; inset:0; display:flex; width:100%; height:100%; min-height:0; box-sizing:border-box; align-items:inherit; justify-content:inherit; gap:inherit; padding:inherit; border:0; border-radius:inherit; color:inherit; background:transparent; font:inherit; line-height:inherit; text-align:inherit; }
.weapp-btn--default > .weapp-btn > .weapp-btn__content { display:flex; width:100%; height:100%; min-width:0; align-items:inherit; justify-content:inherit; gap:inherit; }
.weapp-btn--default > .weapp-btn > .weapp-btn__content > .weapp-btn__text { display:contents; }

/* Keep the 44px host as the touch/focus target without turning the visible
 * pill into a 44px-tall control. 72rpx is the original mini-program pill. */
.ai-trigger {
  width: 190rpx;
  min-width: 190rpx;
  max-width: 190rpx;
  height: var(--yy-v3-touch, 88rpx);
  min-height: var(--yy-v3-touch, 88rpx);
  max-height: var(--yy-v3-touch, 88rpx);
  padding: 0;
  border: 0;
  border-radius: 44rpx;
  background: transparent;
  box-shadow: none;
  white-space: nowrap;
}

.ai-trigger-visual {
  display: flex;
  width: 190rpx;
  height: 72rpx;
  min-height: 72rpx;
  box-sizing: border-box;
  pointer-events: none;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  border: 2rpx solid #D6A84B;
  border-radius: 38rpx;
  background: #172333;
  color: #F4D99D;
  box-shadow: 0 12rpx 26rpx rgba(4, 11, 22, .28);
}

.ai-trigger:focus-within .ai-trigger-visual {
  outline: 3rpx solid rgba(244, 217, 157, .72);
  outline-offset: 2rpx;
}
