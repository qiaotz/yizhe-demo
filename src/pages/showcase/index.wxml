<view class="welcome-page">
  <yy-nav theme="v3" title="首次体验" back="true"/>
  <view class="welcome-content">
    <view class="welcome-brand"><view class="welcome-dots"><view/><view/><view/><view/><view/></view><text>医者 · 学习体验</text></view>
    <view class="welcome-title">把知识学懂，<view>也把它真正留下来</view></view>
    <view class="welcome-subtitle">先了解我们的学习方法，再亲手走完这一轮。</view>
    <view class="welcome-video-label"><text>引导视频</text><text>从这里开始</text></view>
    <video wx:if="{{videoPlaying}}" id="portfolio-intro-video" class="welcome-video" src="{{introVideoSrc}}" poster="/images/guide/yizhe-guide-cover-v1.webp" controls="{{true}}" autoplay="{{true}}" show-fullscreen-btn="{{true}}" object-fit="contain" binderror="onVideoError"/>
    <button wx:else class="welcome-video-cover" bindtap="playIntro" aria-label="播放医者 V5 引导视频，约 34 秒">
      <image class="welcome-cover-image" src="/images/guide/yizhe-guide-cover-v1.webp" mode="aspectFit"/>
      <view class="welcome-play">▶</view><text class="welcome-duration">00:34</text>
    </button>
    <view class="welcome-video-note">{{videoError ? '视频暂未加载成功，点击重试或直接开始体验。' : '点击播放 · 可随时跳过'}}</view>
    <view class="welcome-version">V5 历史视频，部分界面与当前演示不同。</view>
    <view class="welcome-journey">
      <view class="welcome-journey-head"><view><view class="welcome-journey-title">一轮完整学习</view><text>从找到重点，到验证掌握</text></view><text class="welcome-badge">跟着做一遍</text></view>
      <view class="welcome-steps"><view class="step-preview"><view/><text>预习</text></view><view class="step-class"><view/><text>上课</text></view><view class="step-practice"><view/><text>做题</text></view><view class="step-correction"><view/><text>改错</text></view><view class="step-review"><view/><text>复习</text></view></view>
      <view class="welcome-journey-copy">沿着“预习—上课—做题—改错—复习”，把理解变成能够独立运用的知识。</view>
    </view>
    <view class="welcome-safe">✓ 放心体验：不计入正式学习记录，也不消耗 AI 额度</view>
    <view class="welcome-example">免登录 · 精选示例 · AI 回答为预置内容</view>
    <button class="welcome-more" bindtap="toggleDetails">{{showDetails ? '收起更多选项 −' : '更多体验选项 ＋'}}</button>
    <view wx:if="{{showDetails}}" class="welcome-explore">
      <button bindtap="openClassroom">知识课堂 →</button>
      <button bindtap="openCorrection">AI 错因归因 →</button>
      <button bindtap="openReview">主动回忆 →</button>
      <button bindtap="reset">重置本地体验进度</button>
    </view>
    <button wx:if="{{canResume && !completed}}" class="welcome-resume" bindtap="resume">继续上次体验 →</button>
  </view>
  <view class="welcome-actions"><button class="welcome-start" bindtap="start">开始体验</button><button class="welcome-skip" bindtap="skip">跳过介绍，进入预习</button></view>
</view>
