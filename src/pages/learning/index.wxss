page {
  background: var(--yy-v3-canvas, #0A0F16);
}

button { font-family: var(--yy-v3-font); }
.card-title,.section-title,.task-title { font-family:var(--yy-v3-display-font,var(--yy-v3-font)); letter-spacing:var(--yy-v3-title-letter-spacing,0); }

.prototype-card {
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--yy-v3-line);
  border-radius: var(--yy-v3-radius-card, 32rpx);
  background: var(--yy-v3-surface-muted);
}

.main-task {
  padding: var(--yy-v3-space-lg, 32rpx);
  border-color: var(--yy-v3-class-border);
  background: var(--yy-v3-surface-raised);
  box-shadow: 0 16rpx 40rpx rgba(0, 6, 13, .18);
}

.eyebrow {
  color: var(--yy-v3-class);
  font-size: 23rpx;
  line-height: 34rpx;
  font-weight: 600;
  letter-spacing: .04em;
}

.card-title {
  margin-top: 12rpx;
  color: var(--yy-v3-text);
  font-size: 33rpx;
  line-height: 47rpx;
  font-weight: 600;
  word-break: break-word;
}

.main-task-desc {
  margin-top: 10rpx;
  color: var(--yy-v3-text-secondary);
  font-size: 25rpx;
  line-height: 38rpx;
  word-break: break-word;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.chip {
  display: inline-flex;
  min-height: 44rpx;
  box-sizing: border-box;
  align-items: center;
  padding: 4rpx 16rpx;
  border: 1rpx solid var(--yy-v3-line-strong);
  border-radius: 999rpx;
  color: var(--yy-v3-text-secondary);
  font-size: 22rpx;
  line-height: 32rpx;
  font-weight: 500;
  white-space: nowrap;
}

.main-task yy-button { display: block; margin-top: 24rpx; }

.secondary-card { background: var(--yy-v3-surface-muted); }

.section-heading,
.resolved-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  color: var(--yy-v3-text);
  font-size: 29rpx;
  line-height: 42rpx;
  font-weight: 600;
}

.section-caption {
  margin-top: 4rpx;
  color: var(--yy-v3-text-muted);
  font-size: 23rpx;
  line-height: 34rpx;
}

.task-row {
  display: grid;
  min-height: 112rpx;
  box-sizing: border-box;
  grid-template-columns: 64rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--yy-v3-line);
}

.task-list { margin-top: 14rpx; }

.task-icon {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: var(--yy-v3-radius-compact, 16rpx);
  background: var(--yy-v3-class-soft);
}

.task-icon image { width: 34rpx; height: 34rpx; }
.task-copy { min-width: 0; }

.task-title {
  color: var(--yy-v3-text);
  font-size: 27rpx;
  line-height: 40rpx;
  font-weight: 600;
  word-break: break-word;
}

.task-sub {
  margin-top: 5rpx;
  color: var(--yy-v3-text-muted);
  font-size: 23rpx;
  line-height: 35rpx;
  font-weight: 400;
  word-break: break-word;
}

.task-action {
  display: flex;
  max-width: 116rpx;
  flex: none;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  color: var(--yy-v3-class);
  font-size: 22rpx;
  line-height: 32rpx;
  font-weight: 600;
  text-align: right;
  white-space: nowrap;
}

.task-action image {
  width: 20rpx;
  height: 20rpx;
  flex: none;
  transform: rotate(-90deg);
}

.queue-empty {
  display: flex;
  min-height: 104rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 18rpx 0 6rpx;
  border-top: 1rpx solid var(--yy-v3-line);
  color: var(--yy-v3-text-secondary);
  font-size: 24rpx;
  line-height: 35rpx;
}

.queue-empty.compact { min-height: 92rpx; }
.queue-empty-copy { flex: 1; min-width: 0; }

.queue-empty text {
  display: block;
  margin-top: 3rpx;
  color: var(--yy-v3-text-muted);
  font-size: 23rpx;
  line-height: 34rpx;
}

.queue-retry {
  display: flex;
  width: auto;
  min-width: 112rpx;
  min-height: var(--yy-v3-touch, 88rpx);
  flex: none;
  align-items: center;
  justify-content: center;
  margin: -8rpx -10rpx -8rpx 0;
  padding: 0 10rpx;
  color: var(--yy-v3-class);
  background: transparent;
  font-size: 23rpx;
  line-height: 1.2;
  font-weight: 600;
}

.queue-retry::after { display: none; }

.empty-mark {
  width: 10rpx;
  height: 10rpx;
  flex: none;
  border-radius: 50%;
  background: var(--yy-v3-class);
  box-shadow: 0 0 0 7rpx var(--yy-v3-class-soft);
}

.empty-mark.success {
  background: var(--yy-v3-review);
  box-shadow: 0 0 0 7rpx var(--yy-v3-review-soft);
}

.resolved-count {
  display: flex;
  flex: none;
  align-items: baseline;
  gap: 5rpx;
  color: var(--yy-v3-text-muted);
  font-size: 23rpx;
  line-height: 34rpx;
}

.resolved-count .yy-v3-number {
  color: var(--yy-v3-review);
  font-size: 31rpx;
  line-height: 36rpx;
  font-weight: 600;
}

.solved-list { margin-top: 12rpx; }

.solved-row {
  display: grid;
  grid-template-columns: 38rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--yy-v3-line);
}

.solved-mark { width: 38rpx; height: 38rpx; }
.solved-copy { min-width: 0; }

.solved-title {
  color: var(--yy-v3-text-secondary);
  font-size: 25rpx;
  line-height: 38rpx;
  font-weight: 500;
  word-break: break-word;
}

.solved-sub {
  margin-top: 3rpx;
  color: var(--yy-v3-text-muted);
  font-size: 23rpx;
  line-height: 34rpx;
  word-break: break-word;
}

.solved-state {
  flex: none;
  color: var(--yy-v3-review);
  font-size: 22rpx;
  line-height: 32rpx;
  font-weight: 600;
}

.solved-more {
  margin-top: 16rpx;
  color: var(--yy-v3-text-muted);
  font-size: 23rpx;
  line-height: 34rpx;
  text-align: center;
}

.resolved-card { margin-bottom: var(--yy-v3-touch, 88rpx); }

@media (max-width: 340px) {
  .main-task { padding: 26rpx; }
  .prototype-card { padding-right: 22rpx; padding-left: 22rpx; }
  .task-row { grid-template-columns: 58rpx minmax(0, 1fr) auto; gap: 13rpx; }
  .task-icon { width: 58rpx; height: 58rpx; }
  .queue-sync { align-items: flex-start; flex-wrap: wrap; }
  .queue-retry { margin-left: 26rpx; }
}
