.history-row + .history-row { border-top:1rpx solid var(--yy-v3-line); }
.history-row-layout { padding:18rpx 22rpx; }
.history-row-hover { background:var(--yy-v3-surface-raised); }
.history-toggle {
  width:244rpx;
  min-height:88rpx;
  margin-top:4rpx;
  margin-right:0;
  margin-left:auto;
  padding:16rpx 0;
  border:0;
  border-radius:0;
  background:transparent;
