.nav-root { display:block; width:100%; }
.nav-spacer { width: 100%; }
.nav { position: fixed; z-index: var(--yy-v3-z-nav, 90); top: 0; right: var(--yy-h5-fixed-inset, 0px); left: var(--yy-h5-fixed-inset, 0px); display: grid; grid-template-columns: 120rpx 1fr 120rpx; align-items: center; box-sizing: content-box; border-bottom: 1rpx solid rgba(229,234,243,.82); background: rgba(255,254,253,.97); color: #1D3153; }
.nav.transparent { border-bottom-color: transparent; background: rgba(239,245,255,.90); }
.nav-title { overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; font-size: 30rpx; font-weight: 800; }
.nav-side { display: flex; min-width: 0; align-items: center; padding-left: 18rpx; }
.nav-side.right { justify-content: flex-end; padding-right: 18rpx; padding-left: 0; }
.back { display: flex; width: 104rpx; height: 68rpx; padding: 0; align-items: center; justify-content: center; gap: 4rpx; border: 0; border-radius: 20rpx; color: #1D3153; background: rgba(255,255,255,.74); font-size: 24rpx; font-weight: 500; }
.back::after { display:none; }
.back.back--pressed { opacity: var(--yy-v3-pressed-opacity, .94); transform:scale(.97); }
.back image { flex: 0 0 auto; width: 28rpx; height: 28rpx; }
.nav.theme-v3 { border-bottom-color: var(--yy-v3-line, #263343); color: var(--yy-v3-text, #F2F5F8); background: var(--yy-v3-nav-bg, rgba(10, 15, 22, .96)); }
.nav.theme-v3.transparent { border-bottom-color: transparent; background: var(--yy-v3-nav-bg-transparent, rgba(10, 15, 22, .88)); }
.nav.theme-v3 .nav-title { display:flex; align-items:center; justify-content:center; gap:12rpx; font-family:var(--yy-v3-display-font,var(--yy-v3-font)); font-size:40rpx; line-height:56rpx; font-weight:600; letter-spacing:var(--yy-v3-title-letter-spacing,.02em); }
.nav.theme-v3.no-stage-dot .nav-title { font-size:30rpx; line-height:44rpx; font-weight:600; letter-spacing:0; }
.nav.theme-v3 .stage-dot { width:16rpx; height:16rpx; border-radius:50%; background:var(--yy-v3-stage, var(--yy-v3-focus,#45A3FF)); }
.nav.theme-v3 .back { display:flex; width:112rpx; height:var(--yy-v3-touch, 88rpx); padding:0; align-items:center; justify-content:flex-start; gap:4rpx; border-radius:0; color:var(--yy-v3-text-secondary, #B7C1CE); background:transparent; font-size:26rpx; font-weight:500; transition:opacity var(--yy-v3-duration-fast, 160ms) var(--yy-v3-ease-out, ease-out); }
.nav.theme-v3 .back image { width:32rpx; height:32rpx; }
.nav.theme-v3.no-stage-dot .back { color:var(--yy-v3-text, #F2F5F8); font-size:24rpx; }
.nav.theme-v3 .nav-side.right { position:absolute; width:auto; padding:0; }
.nav.theme-v3.stage-preview,.nav.theme-v3.stage-class,.nav.theme-v3.stage-practice,.nav.theme-v3.stage-review,.nav.theme-v3.stage-correction { border-bottom-color:transparent; }
.nav.theme-v3.stage-preview { --yy-v3-stage:var(--yy-v3-preview,#4CBFD3); }
.nav.theme-v3.stage-class { --yy-v3-stage:var(--yy-v3-class,#D6A84B); }
.nav.theme-v3.stage-practice { --yy-v3-stage:var(--yy-v3-practice,#5B7FFF); }
.nav.theme-v3.stage-review { --yy-v3-stage:var(--yy-v3-review,#3FB982); }
.nav.theme-v3.stage-correction { --yy-v3-stage:var(--yy-v3-correction,#E96B50); }
