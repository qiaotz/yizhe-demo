<button class="yy-button theme-{{theme}} tone-{{tone}} {{tone === 'orange' ? 'yy-orange-button' : tone === 'outline' ? 'yy-outline-button' : 'yy-primary-button'}}" disabled="{{disabled || loading}}" form-type="{{formType}}" aria-label="{{loading ? '处理中' : ariaLabel}}" aria-busy="{{loading}}" hover-class="yy-button--pressed" hover-start-time="20" hover-stay-time="180" bindkeydown="handleKeyDown" catchtap="tap"><text wx:if="{{loading}}">处理中…</text><slot wx:else /></button>
