@media (max-width:344px) { .stability-panel,.flow-panel { padding:22rpx; }.panel-heading > view text:last-child,.stability-meta,.flow-meta { font-size:10px; }.stability-title,.flow-title { font-size:12px; }.flow-row { min-height:44px; align-items:stretch; flex-direction:column; gap:10rpx; padding:16rpx; }.flow-action { max-width:100%; min-height:28px; box-sizing:border-box; align-self:flex-start; justify-content:center; font-size:10px; }.percent { min-width:60rpx; } }
