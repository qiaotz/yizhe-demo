.panel-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:18rpx; padding-bottom:18rpx; border-bottom:1rpx solid var(--yy-v3-line); }.panel-heading > view { min-width:0; }.panel-heading > view text { display:block; color:var(--yy-v3-text); font-size:28rpx; font-weight:600; }.panel-heading > view text:last-child { margin-top:5rpx; color:var(--yy-v3-text-muted); font-size:21rpx; line-height:1.45; font-weight:400; }.panel-heading > text,.period-chip { flex:none; color:var(--yy-v3-review); font-size:23rpx; }.period-chip { padding:5rpx 14rpx; border:1rpx solid var(--yy-v3-line-strong); border-radius:999rpx; color:var(--yy-v3-text-secondary); background:var(--yy-v3-surface-raised); font-size:20rpx; }
.stability-list { margin-top:2rpx; }.stability-item { min-height:104rpx; box-sizing:border-box; padding:20rpx 0; }.stability-item + .stability-item { border-top:1rpx solid var(--yy-v3-line); }.stability-item.highlighted { padding-right:14rpx; padding-left:14rpx; border-left:3rpx solid var(--yy-v3-review); border-radius:0 14rpx 14rpx 0; background:linear-gradient(90deg,var(--yy-v3-review-soft),var(--yy-v3-review-ambient)); }.stability-copy { display:flex; align-items:flex-start; justify-content:space-between; gap:18rpx; }.stability-info { min-width:0; flex:1; }.stability-title { display:-webkit-box; overflow:hidden; color:var(--yy-v3-text-secondary); font-size:25rpx; line-height:1.45; font-weight:500; white-space:normal; word-break:break-all; -webkit-box-orient:vertical; -webkit-line-clamp:2; }.stability-meta { display:block; margin-top:6rpx; color:var(--yy-v3-text-muted); font-size:20rpx; line-height:1.45; font-weight:400; white-space:normal; }.percent { min-width:76rpx; flex:none; padding-top:2rpx; font-size:24rpx; font-weight:600; text-align:right; }.percent.good { color:var(--yy-v3-review); }.percent.mid { color:var(--yy-v3-class); }.percent.bad { color:var(--yy-v3-correction); }.bar { overflow:hidden; height:8rpx; margin-top:10rpx; border-radius:999rpx; background:var(--yy-v3-surface-floating); }.fill { height:100%; border-radius:999rpx; }.fill.good { background:var(--yy-v3-review); }.fill.mid { background:var(--yy-v3-class); }.fill.bad { background:var(--yy-v3-correction); }
