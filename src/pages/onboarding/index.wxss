.portfolio-receipt{padding:44rpx 40rpx 80rpx;background:#0a0f16;color:#dce8f2}.receipt-mark{width:110rpx;height:110rpx;border:1rpx solid #438e79;border-radius:50%;display:flex;justify-content:center;align-items:center;font-size:60rpx;color:#70d2ad;margin:10rpx auto 36rpx}.receipt-heading{font-size:40rpx;line-height:1.5;font-weight:600;text-align:center}.receipt-intro{font-size:27rpx;line-height:1.85;color:#a7bdce;margin-top:26rpx}.receipt-steps{margin:36rpx 0;padding:12rpx 28rpx;background:#131f2b;border:1rpx solid #293d4a;border-radius:24rpx}.receipt-steps>view{display:flex;justify-content:space-between;gap:16rpx;padding:22rpx 0;border-bottom:1rpx solid #253743;font-size:24rpx}.receipt-steps>view:last-child{border:0}.receipt-steps text:first-child{color:#93d5d9;white-space:nowrap}.receipt-steps text:last-child{color:#a9bdcb}.receipt-note{font-size:23rpx;line-height:1.7;color:#829caf;margin:24rpx 0 38rpx}
